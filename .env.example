# Copy this file to .env and fill in the values you use.

# OpenAI-compatible LiteLLM endpoint.
# The notebooks will normalize this to include scheme and /v1 when needed.
LLM_BASE_URL=https://litellm.imt-soft/v1

# Model alias/name exposed by your LiteLLM server.
LLM_MODEL_NAME=your-litellm-model-name

# Optional. Leave unset if your self-hosted LiteLLM endpoint does not require auth.
# LLM_API_KEY=

